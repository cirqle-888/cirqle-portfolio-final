# ─── Website Supabase project ────────────────────────────────────────────────
# A project used ONLY for public website content (portfolio + supermarket
# flyers). This is deliberately NOT the project behind cirqle-app, so the key
# published in this site's JavaScript can never reach business data.
# See supabase/README.md for setup. Without these the portfolio is empty and
# the flyer gallery falls back to a placeholder — nothing breaks.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_key"

# Optional overrides
# VITE_SUPABASE_FLYERS_BUCKET="flyers"
# VITE_SUPABASE_FLYERS_FOLDER="2026-09"

# NOTE: the service role key is never set here. Vite inlines .env into the
# browser bundle. Pass it on the command line when running scripts/seed-portfolio.mjs.

# ─── Careers ─────────────────────────────────────────────────────────────────
# Public application form hosted in cirqle-app (Recruitment module).
# Optional: only needed to override the default https://app.cirqle.work/careers/apply
VITE_CAREERS_APPLY_URL="https://app.cirqle.work/careers/apply"
